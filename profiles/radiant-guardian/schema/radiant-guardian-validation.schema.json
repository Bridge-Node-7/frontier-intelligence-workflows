    "profile_version": {"type": "string"}, "ruleset_version": {"type": "string"}, "validator_version": {"type": "string"},
    "upstream_pi": {"type": "object"}, "findings": {"type": "array"},
    "validation_status": {"enum": ["NO_RG_FINDINGS", "RG_REVIEW_REQUIRED"]},
    "recommendation": {"enum": ["READY_FOR_HUMAN_REVIEW", "REQUIRE_CORROBORATION", "REQUIRE_DISCRIMINATING_EVIDENCE", "REVISE_PREDICTION", "REASSESS_BEFORE_ACTION", "DO_NOT_RELEASE_PUBLICLY"]},
