{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "frontier-intelligence-workflows",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        },
        {
          "type": "json",
          "path": "REPO_FILE_POLICY.json",
          "jsonpath": "$.release_version"
        },
        {
          "type": "generic",
          "path": "scripts/release_common.py"
        },
        {
          "type": "generic",
          "path": "scripts/frontier_signal_integrity.py"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "LIMITATIONS.md"
        },
        {
          "type": "generic",
          "path": "docs/assurance/TESTING.md"
        }
      ],
      "version-file": "VERSION",
      "exclude-paths": [
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "docs",
        ".github",
        "MANIFEST.sha256",
        "REPO_MANIFEST.json",
        "REPO_FILE_MANIFEST.sha256",
        "SHA256SUMS",
        "release-please-config.json",
        "CHANGELOG.md"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "security",
      "section": "Security"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "chore",
      "section": "Miscellaneous"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    }
  ]
}
